{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codewhen/release-workbench/schema/v3",
  "title": "Workflow Workbench v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "graphs"
  ],
  "properties": {
    "library": {
      "type": "object",
      "additionalProperties": false,
      "description": "Import-only Home organization; does not schedule execution.",
      "properties": {
        "folder": {
          "type": "string",
          "pattern": "^[^/\\\\\\u0000]+(?:/[^/\\\\\\u0000]+)*$"
        },
        "imports": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Additional workflow YAML paths relative to the execution workspace."
        }
      }
    },
    "version": {
      "const": 3
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/parameter"
      }
    },
    "globals": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/global"
      }
    },
    "functions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/function"
      }
    },
    "graphs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/graph"
      },
      "required": [
        "main"
      ]
    },
    "layout": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/layout"
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workspace": {
      "type": "string",
      "minLength": 1,
      "description": "Execution root relative to the workflow YAML directory."
    },
    "report_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "input_detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "$ref"
                ],
                "properties": {
                  "$ref": {
                    "const": "runtime:python"
                  }
                }
              }
            ]
          }
        },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        }
      }
    },
    "skip_cards": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "graph",
          "card"
        ],
        "properties": {
          "graph": {
            "type": "string",
            "minLength": 1
          },
          "card": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "void",
            "null",
            "boolean",
            "number",
            "string",
            "array",
            "object",
            "json"
          ]
        },
        "default": {},
        "description": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "global": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "null",
            "boolean",
            "number",
            "string",
            "array",
            "object",
            "json"
          ]
        },
        "initial": {}
      },
      "required": [
        "type",
        "initial"
      ],
      "additionalProperties": false
    },
    "function": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "graph": {
          "type": "string"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/parameter"
          }
        },
        "returns": {
          "enum": [
            "void",
            "null",
            "boolean",
            "number",
            "string",
            "array",
            "object",
            "json"
          ]
        }
      },
      "required": [
        "graph",
        "returns"
      ],
      "additionalProperties": false
    },
    "owner": {
      "type": "object",
      "properties": {
        "card": {
          "type": "string"
        },
        "region": {
          "type": "string"
        }
      },
      "required": [
        "card",
        "region"
      ],
      "additionalProperties": false
    },
    "card": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "kind": {
          "enum": [
            "start",
            "finish",
            "return",
            "if",
            "loop",
            "variable",
            "calculate",
            "break",
            "continue",
            "parallel",
            "join",
            "try",
            "python",
            "bash",
            "script",
            "program",
            "check_path",
            "read_file",
            "write_file",
            "http",
            "wait",
            "poll",
            "manual",
            "call",
            "workspace"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "type": "object",
          "additionalProperties": true
        },
        "inputs": {
          "type": "object",
          "additionalProperties": true
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "settings": {
          "type": "object",
          "properties": {
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "resources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exclusive": {
              "type": "boolean"
            },
            "interactive": {
              "type": "boolean"
            },
            "retry": {
              "type": "object",
              "properties": {
                "attempts": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "delay": {
                  "type": "number",
                  "minimum": 0
                },
                "backoff": {
                  "type": "number",
                  "minimum": 1
                },
                "errors_contain": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "attempts"
              ],
              "additionalProperties": false
            },
            "cwd": {
              "type": "string"
            },
            "environment": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "expected_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "kind",
        "name"
      ],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "source_port": {
          "type": "string"
        },
        "target_port": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "flow",
            "value"
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "kind"
      ],
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "properties": {
        "cards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/card"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      },
      "required": [
        "cards",
        "edges"
      ],
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "area": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "area",
            "collapsible",
            "annotation"
          ]
        },
        "name": {
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/point"
        },
        "width": {
          "type": "number",
          "minimum": 100
        },
        "height": {
          "type": "number",
          "minimum": 80
        },
        "collapsed": {
          "type": "boolean"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "position"
      ],
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "positions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/point"
          }
        },
        "areas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/area"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
}
