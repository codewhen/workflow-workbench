{
  "name": "release-workbench-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-schema.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run generate && node scripts/licenses.mjs && npm run typecheck && vite build",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/*.ts\" \"*.ts\""
  },
  "dependencies": {
    "@xyflow/react": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^6.4.5",
    "vitest": "^5.0.4"
  }
}
